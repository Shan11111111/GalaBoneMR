<?xml version="1.0" encoding="utf-8" standalone="no"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:horizonos="http://schemas.horizonos/sdk"
    android:installLocation="auto">

	<!-- ========================================= -->
	<!-- GalaBoneMR Camera Permissions             -->
	<!-- ========================================= -->

	<!-- Android Runtime Camera Permission -->
	<uses-permission
        android:name="android.permission.CAMERA" />

	<!-- Meta Quest Passthrough Camera API Permission -->
	<uses-permission
        android:name="horizonos.permission.HEADSET_CAMERA" />


	<!-- ========================================= -->
	<!-- Hardware / Quest Features                 -->
	<!-- ========================================= -->

	<uses-feature
        android:name="android.hardware.vr.headtracking"
        android:version="1"
        android:required="true" />

	<uses-feature
        android:name="com.oculus.feature.PASSTHROUGH"
        android:required="false" />


	<!-- ========================================= -->
	<!-- Application                               -->
	<!-- ========================================= -->

	<application
        android:label="@string/app_name"
        android:icon="@mipmap/app_icon"
        android:allowBackup="false">

		<activity
            android:name="com.unity3d.player.UnityPlayerGameActivity"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:configChanges="locale|fontScale|keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:exported="true">

			<intent-filter>
				<action android:name="android.intent.action.MAIN" />

				<category android:name="android.intent.category.LAUNCHER" />

				<category android:name="com.oculus.intent.category.VR" />
			</intent-filter>

			<meta-data
                android:name="com.oculus.vr.focusaware"
                android:value="true" />

		</activity>


		<!-- 讓 Unity 顯示 Android Runtime Permission Dialog -->
		<meta-data
            android:name="unityplayer.SkipPermissionsDialog"
            android:value="false" />


		<!-- Meta Quest Passthrough Splash -->
		<meta-data
            android:name="com.oculus.ossplash.background"
            android:value="passthrough-contextual" />


		<!-- Meta Project GUID -->
		<meta-data
            android:name="com.oculus.telemetry.project_guid"
            android:value="dd0e5449-5a40-48f1-80c6-1578f5a02fc9" />


		<!-- Supported Quest Devices -->
		<meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest|quest2|questpro|quest3|quest3s"
            tools:replace="android:value" />

	</application>


	<!-- ========================================= -->
	<!-- Horizon OS SDK                            -->
	<!-- ========================================= -->

	<horizonos:uses-horizonos-sdk
        horizonos:minSdkVersion="60"
        horizonos:targetSdkVersion="205" />

</manifest>